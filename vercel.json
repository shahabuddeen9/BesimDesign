{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/hospitality/:slug",
      "destination": "/api/index?__page=/hospitality/:slug"
    },
    {
      "source": "/hotels/:slug",
      "destination": "/api/index?__page=/hotels/:slug"
    },
    {
      "source": "/residential/:slug",
      "destination": "/api/index?__page=/residential/:slug"
    },
    {
      "source": "/central-kitchen/:slug",
      "destination": "/api/index?__page=/central-kitchen/:slug"
    },
    {
      "source": "/contact",
      "destination": "/index.html#contact"
    },
    {
      "source": "/admin",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/projects",
      "destination": "/admin/dashboard.html?tab=projects"
    },
    {
      "source": "/admin/enquiries",
      "destination": "/admin/dashboard.html?tab=enquiries"
    },
    {
      "source": "/admin/clients",
      "destination": "/admin/dashboard.html?tab=clients"
    },
    {
      "source": "/admin/testimonials",
      "destination": "/admin/dashboard.html?tab=testimonials"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm,server/db/**"
    }
  }
}
