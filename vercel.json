{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/projects",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/showcase",
      "statusCode": 301
    },
    {
      "source": "/projects.html",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/showcase",
      "statusCode": 301
    },
    {
      "source": "/testimonials",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/",
      "statusCode": 301
    },
    {
      "source": "/testimonials.html",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/#contact",
      "statusCode": 301
    },
    {
      "source": "/contact.html",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/#contact",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.besimdesign.com"
        }
      ],
      "destination": "https://besimdesign.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/hotels.html",
      "destination": "/hotels",
      "statusCode": 301
    },
    {
      "source": "/hospitality.html",
      "destination": "/hospitality",
      "statusCode": 301
    },
    {
      "source": "/residential.html",
      "destination": "/residential",
      "statusCode": 301
    },
    {
      "source": "/central-kitchen.html",
      "destination": "/central-kitchen",
      "statusCode": 301
    },
    {
      "source": "/showcase.html",
      "destination": "/showcase",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/projects",
      "destination": "/showcase",
      "statusCode": 301
    },
    {
      "source": "/projects.html",
      "destination": "/showcase",
      "statusCode": 301
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/testimonials.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "statusCode": 301
    },
    {
      "source": "/contact.html",
      "destination": "/#contact",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/hospitality/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/hotels/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/residential/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/central-kitchen/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/projects",
      "destination": "/admin/dashboard.html?tab=projects"
    },
    {
      "source": "/admin/enquiries",
      "destination": "/admin/dashboard.html?tab=enquiries"
    },
    {
      "source": "/admin/clients",
      "destination": "/admin/dashboard.html?tab=clients"
    },
    {
      "source": "/admin/testimonials",
      "destination": "/admin/dashboard.html?tab=testimonials"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm,server/db/**,public/*.html,public/robots.txt,public/favicon.svg,*.html"
    }
  }
}
