# ==============================================================================
# Besim Design Environment Configuration
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Production Managed Database (Supabase / Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Set DATABASE_URL or POSTGRES_URL to your managed PostgreSQL connection string:
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Local/Testing SQLite Database Path (Used ONLY when DATABASE_URL is not set)
DB_PATH=server/db/fusion.db

# ------------------------------------------------------------------------------
# Persistent Asset Storage (Supabase Storage for Vercel Serverless)
# ------------------------------------------------------------------------------
# Optional: Provide Supabase Storage credentials to store client logos and project
# galleries in durable cloud buckets. If omitted, files automatically persist in
# PostgreSQL as high-fidelity Base64 Data URIs without any loss on container restarts.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=besim-assets

# ------------------------------------------------------------------------------
# Administrator Credentials & Security
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@besimdesign.com
ADMIN_PASSWORD=change_this_secure_password_in_production
JWT_SECRET=generate_a_random_64_character_hex_secret_here
IP_HASH_SALT=generate_a_random_salt_for_privacy_analytics

# ------------------------------------------------------------------------------
# Lead Notifications & Communication
# ------------------------------------------------------------------------------
WHATSAPP_NUMBER=+919892699850
NOTIFY_EMAILS=besimdesigne@gmail.com,msfusionarchitects@gmail.com

# SMTP Email Configuration (Optional - Logs to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=